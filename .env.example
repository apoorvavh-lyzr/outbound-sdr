# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Public HTTPS origin of THIS service. Must be https:// in production - the
# Twilio Media Stream URL is derived from it as wss://<host>/twilio-media.
PUBLIC_BASE_URL=https://your-service.up.railway.app

# ---------------------------------------------------------------------------
# Lyzr
# ---------------------------------------------------------------------------
# Voice Agent API key, sent as the x-api-key header. Never commit a real value.
LYZR_API_KEY=
# The production base agent that gets cloned per call. Never modified.
LYZR_BASE_AGENT_ID=6aa13809b4c51e185bbca6ba

# Base for agent CRUD and the LiveKit session lifecycle
# (/agents, /sessions/start, /sessions/end). Override only if Lyzr moves it.
LYZR_VOICE_API_BASE=https://voice-livekit.studio.lyzr.ai/v1

# NOTE: no LiveKit credentials are required. Lyzr issues a per-session
# userToken, which is the only participant credential the backend needs.

LYZR_SESSION_TIMEOUT_MS=15000

# Emergency fallback ONLY. The production path reuses the saved base agent and
# passes per-call lead context as agentConfig on /sessions/start, so nothing is
# created per call. Leave false.
LYZR_ENABLE_AGENT_CLONING=false
LYZR_HTTP_TIMEOUT_MS=20000

# Optional. Only set once a transcript API is confirmed; {sessionId} is substituted.
# Without it, GET /api/calls/:id/transcript honestly reports "not configured".
LYZR_TRANSCRIPT_URL_TEMPLATE=

# ---------------------------------------------------------------------------
# Twilio
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+16263133414
TWILIO_CALL_TIMEOUT_SECONDS=45
# Leave true in production: it authenticates the status webhook.
TWILIO_VALIDATE_WEBHOOKS=true

# ---------------------------------------------------------------------------
# SuperFlow
# ---------------------------------------------------------------------------
# Bearer secret SuperFlow presents to POST /api/call.
SUPERFLOW_SHARED_SECRET=
# Optional completion callback into SuperFlow.
SUPERFLOW_CALLBACK_URL=
SUPERFLOW_CALLBACK_SECRET=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Railway provides this. Omit locally to use an in-memory SQLite fallback.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Audio / limits
# ---------------------------------------------------------------------------
# Caller audio retained while the Lyzr socket connects, so the start of the
# call is not lost. Oldest frames are dropped past this bound.
AUDIO_PRECONNECT_BUFFER_MS=4000

CALL_RATE_LIMIT_MAX=30
CALL_RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Behaviour flags
# ---------------------------------------------------------------------------
# true = no real Lyzr agents and no real phone calls. NEVER enable in production.
MOCK_EXTERNAL_SERVICES=false

# Each call creates an agent clone; completed calls older than this have their
# clone deleted by an hourly sweep. Set to 0 to disable cleanup entirely.
CLONED_AGENT_RETENTION_HOURS=72

# Enables the suppression hook before dialling.
ENABLE_DNC_CHECK=false
