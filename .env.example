# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Public HTTPS origin of THIS service. Must be https:// in production - the
# Twilio Media Stream URL is derived from it as wss://<host>/twilio-media.
PUBLIC_BASE_URL=https://your-service.up.railway.app

# ---------------------------------------------------------------------------
# Lyzr
# ---------------------------------------------------------------------------
# Voice Agent API key, sent as the x-api-key header. Never commit a real value.
LYZR_API_KEY=
# The production base agent that gets cloned per call. Never modified.
LYZR_BASE_AGENT_ID=6aa13809b4c51e185bbca6ba

# Base for agent CRUD and the LiveKit session lifecycle
# (/agents, /sessions/start, /sessions/end). Override only if Lyzr moves it.
LYZR_VOICE_API_BASE=https://voice-livekit.studio.lyzr.ai/v1

# NOTE: no LiveKit credentials are required. Lyzr issues a per-session
# userToken, which is the only participant credential the backend needs.

LYZR_SESSION_TIMEOUT_MS=15000

# Emergency fallback ONLY. The production path reuses the saved base agent and
# passes per-call lead context as agentConfig on /sessions/start, so nothing is
# created per call. Leave false.
LYZR_ENABLE_AGENT_CLONING=false
LYZR_HTTP_TIMEOUT_MS=20000

# Optional. Only set once a transcript API is confirmed; {sessionId} is substituted.
# Without it, GET /api/calls/:id/transcript honestly reports "not configured".
LYZR_TRANSCRIPT_URL_TEMPLATE=

# ---------------------------------------------------------------------------
# Twilio
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+16263133414
TWILIO_CALL_TIMEOUT_SECONDS=45
# Leave true in production: it authenticates the status webhook.
TWILIO_VALIDATE_WEBHOOKS=true

# ---------------------------------------------------------------------------
# SuperFlow
# ---------------------------------------------------------------------------
# Bearer secret SuperFlow presents to POST /api/call.
SUPERFLOW_SHARED_SECRET=
# Optional completion callback into SuperFlow.
SUPERFLOW_CALLBACK_URL=
SUPERFLOW_CALLBACK_SECRET=
# Set ONLY when SUPERFLOW_CALLBACK_URL is the Lyzr workflow-execute API. Its
# presence switches the callback to {workflow_id, input:[...]} with the secret
# sent as x-webhook-secret instead of a bearer token.
SUPERFLOW_CALLBACK_WORKFLOW_ID=
# Intake for the demo form at GET /. This is the Lyzr workflow-execute API,
# not a plain webhook: the lead fields travel inside `input`, addressed to
# SUPERFLOW_INTAKE_WORKFLOW_ID, with the secret sent as x-webhook-secret.
# All three are required in production and never exposed to the browser.
SUPERFLOW_INTAKE_WEBHOOK_URL=https://inference.studio.lyzr.ai/api/workflows/execute
SUPERFLOW_INTAKE_WEBHOOK_SECRET=
SUPERFLOW_INTAKE_WORKFLOW_ID=

# ---------------------------------------------------------------------------
# Google Workspace (demo calendar check + booking)
# ---------------------------------------------------------------------------
# Service account with Domain-Wide Delegation. In Google Admin -> Security ->
# API controls -> Domain-wide delegation, GOOGLE_CLIENT_ID must be authorised
# for the scope https://www.googleapis.com/auth/calendar (used by all three
# endpoints; the read check deliberately shares it so only one scope needs
# delegating).
# None of these block boot: without them the three endpoints answer 503.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the PEM with literal \n sequences (single line); they are unescaped.
GOOGLE_PRIVATE_KEY=
GOOGLE_PRIVATE_KEY_ID=
GOOGLE_CLIENT_ID=
# Mailbox the service account impersonates; also the calendar that is read and
# written unless GOOGLE_DEMO_CALENDAR_ID overrides it.
GOOGLE_IMPERSONATED_USER=demos@lyzr.ai
GOOGLE_DEMO_CALENDAR_ID=
# Upcoming window the pre-call check scans.
DEMO_CHECK_WINDOW_DAYS=90
DEMO_CHECK_TIMEOUT_MS=10000
# Also run the check inside POST /api/call (409 if booked, 502 if the calendar
# cannot be read). Enable once /check-demo-booking is proven in SuperFlow.
ENABLE_DEMO_BOOKING_GUARD=false
# Business hours offered by /demo-slots, in DEMO_TIMEZONE. 0=Sun … 6=Sat.
DEMO_TIMEZONE=Asia/Kolkata
DEMO_HOURS_START=10
DEMO_HOURS_END=18
DEMO_WORKING_DAYS=1,2,3,4,5
DEMO_SLOT_MINUTES=30
DEMO_MIN_NOTICE_MINUTES=60
# Lyzr people invited to every booked demo (comma-separated), optional.
DEMO_HOST_EMAILS=
# Tools the base agent must carry before a call is dialled. Default is the
# Composio pair. Once the agent books through this backend, set it to the
# names Lyzr Studio generated for the custom tool set, which are
# openapi-<toolset>-<operationId>, e.g.
#   LYZR_REQUIRED_AGENT_TOOLS=openapi-demobooking-findDemoSlots,openapi-demobooking-bookDemo
# Empty disables the gate.
#LYZR_REQUIRED_AGENT_TOOLS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Railway provides this. Omit locally to use an in-memory SQLite fallback.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Audio / limits
# ---------------------------------------------------------------------------
# Caller audio retained while the Lyzr socket connects, so the start of the
# call is not lost. Oldest frames are dropped past this bound.
AUDIO_PRECONNECT_BUFFER_MS=1000

CALL_RATE_LIMIT_MAX=30
CALL_RATE_LIMIT_WINDOW_MS=60000

# ---------------------------------------------------------------------------
# Behaviour flags
# ---------------------------------------------------------------------------
# true = no real Lyzr agents and no real phone calls. NEVER enable in production.
MOCK_EXTERNAL_SERVICES=false

# Each call creates an agent clone; completed calls older than this have their
# clone deleted by an hourly sweep. Set to 0 to disable cleanup entirely.
CLONED_AGENT_RETENTION_HOURS=72

# Enables the suppression hook before dialling.
ENABLE_DNC_CHECK=false
